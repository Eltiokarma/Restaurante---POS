# Copia este archivo a .env y ajusta los valores
# Contraseña para entrar a /admin
ADMIN_PASSWORD=cambiame123

# Ruta del archivo SQLite (relativa a la carpeta backend/)
DATABASE_PATH=pos.db

# PIN del local: SOLO para despliegues en internet (Railway). Si se define,
# todas las pantallas piden este PIN una vez por dispositivo. En la LAN del
# local déjalo sin definir.
# PIN_LOCAL=

# --- Pedido por voz (Fase 3, opcional) ---
# Sin estas claves el botón de voz no aparece aunque el toggle esté encendido.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MODELO_INTERPRETE=claude-opus-5
