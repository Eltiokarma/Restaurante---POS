# Copia este archivo a .env y pon tus claves reales

# Clave de Anthropic (interpretación del pedido) — console.anthropic.com
ANTHROPIC_API_KEY=

# Clave de OpenAI (transcripción con Whisper) — platform.openai.com
OPENAI_API_KEY=

# Modelo de Claude para interpretar (opcional)
MODELO_INTERPRETE=claude-opus-5
