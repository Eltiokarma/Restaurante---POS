<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F0E4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textColor="#221A14"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo"
            android:textColor="#6C6155"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/rotulo_url"
            android:textColor="#221A14"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campo_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="@string/pista_url"
            android:inputType="textUri"
            android:textSize="16sp"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rotulo_pin"
            android:textColor="#221A14"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campo_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="@string/pista_pin"
            android:inputType="numberPassword"
            android:textSize="16sp"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/boton_servicio"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2F6B3A"
            android:text="@string/iniciar"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/boton_bateria"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:text="@string/boton_bateria"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/vista_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/estado_inicial"
            android:textColor="#221A14"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vista_bitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFDF8"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#4D4438"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
